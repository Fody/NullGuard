<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Fody" Version="6.8.0" />
    <PackageVersion Include="FodyHelpers" Version="6.8.0" />
    <PackageVersion Include="FodyPackaging" Version="6.8.0" />
    <PackageVersion Include="JetBrains.Annotations" Version="2023.3.0" />
    <PackageVersion Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageVersion Include="System.Collections.Immutable" Version="9.0.0" />
    <!-- the TUnit metapackage is not used since it brings in a Mono.Cecil that conflicts with the Cecil used by Fody -->
    <PackageVersion Include="TUnit.Core" Version="1.69.0" />
    <PackageVersion Include="TUnit.Assertions" Version="1.69.0" />
    <PackageVersion Include="TUnit.Engine" Version="1.69.0" />
    <PackageVersion Include="Verify.ICSharpCode.Decompiler" Version="3.4.1" />
    <PackageVersion Include="Verify.TUnit" Version="31.28.0" />
  </ItemGroup>
</Project>
